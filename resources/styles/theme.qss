        /* ============ TOOLTIP (popup khi hover) ============ */
        QToolTip {
            background-color: @TOOLTIP_BG;
            color: @TOOLTIP_TEXT;
            border: 1px solid #334155;
            border-radius: 6px;
            padding: 6px 12px;
            font-size: 12px;
        }

        /* ============ NỀN CHÍNH ============ */
        QMainWindow, QWidget#centralRoot, #contentArea {
            background-color: @BG;
        }
        QWidget {
            color: @TEXT_BODY;
            font-size: 13px;
        }
        QLabel {
            background: transparent;
        }

        /* ============ SIDEBAR ============ */
        #sidebar {
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 @ACCENT, stop:1 @ACCENT_DARK);
            border-right: 1px solid rgba(0, 0, 0, 0.1);
        }
        #logoButton {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            font-size: 15px;
            font-weight: bold;
            border: none;
            border-radius: 12px;
        }
        #sidebarLine {
            color: rgba(255, 255, 255, 0.18);
            background: rgba(255, 255, 255, 0.18);
            max-height: 1px;
            border: none;
        }
        #navButton {
            background: transparent;
            border: none;
            border-radius: 10px;
        }
        #navButton:hover {
            background: rgba(255, 255, 255, 0.15);
        }
        #navButton:checked {
            background: rgba(255, 255, 255, 0.25);
        }
        #avatarButton {
            background: rgba(255, 255, 255, 0.16);
            color: white;
            font-size: 13px;
            font-weight: bold;
            border: 1.5px solid rgba(255, 255, 255, 0.25);
            border-radius: 22px;
        }
        #avatarButton:hover {
            background: rgba(255, 255, 255, 0.28);
            border: 1.5px solid white;
        }
        #sidebarFooter {
            color: rgba(255, 255, 255, 0.4);
            font-size: 10px;
        }

        /* ============ TIÊU ĐỀ TRANG ============ */
        #pageTitle {
            font-size: 22px;
            font-weight: 700;
            color: @TEXT;
        }
        #pageSubtitle {
            font-size: 12px;
            color: @TEXT_MUTED;
        }

        /* ============ BUDGET PAGE ============ */
        #budgetHeader {
            font-size: 16px;
            font-weight: bold;
            color: @TEXT;
            margin-top: 10px;
            margin-bottom: 5px;
        }
        #emptyLabel {
            color: @TEXT_MUTED;
            font-size: 14px;
            margin-top: 40px;
        }

        /* ============ SETTINGS PAGE ============ */
        #sectionTitle {
            font-size: 16px;
            font-weight: 700;
            color: @TEXT;
        }
        #settingTitle {
            font-size: 14px;
            font-weight: 600;
            color: @TEXT_BODY;
        }
        #settingDesc {
            font-size: 12px;
            color: @TEXT_MUTED;
        }
        #badge {
            background-color: @DISABLED_BG;
            color: @TEXT_BODY;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 10px;
        }
        #footerTitle {
            font-size: 13px;
            font-weight: 600;
            color: @TEXT_BODY;
        }
        #footerText {
            font-size: 12px;
            color: @TEXT_MUTED;
        }
        #accentButton {
            border-radius: 17px;
            border: 1.5px solid transparent;
            background-color: rgba(148, 163, 184, 0.25);
        }
        #accentButton:checked {
            border: 2px solid @ACCENT;
            background-color: rgba(148, 163, 184, 0.5);
        }
        #accentButton:hover {
            background-color: rgba(148, 163, 184, 0.38);
        }

        /* ============ CARD ============ */
        #card {
            background-color: @CARD;
            border: 1px solid @BORDER;
            border-radius: 12px;
        }
        #cardTitle {
            font-size: 12px;
            font-weight: 600;
            color: @TEXT_MUTED;
            background: transparent;
            border: none;
        }
        #cardValue {
            font-size: 22px;
            font-weight: 700;
            color: @TEXT;
            background: transparent;
            border: none;
        }
        #cardValueGreen { color: #059669; }
        #cardValueRed   { color: #E11D48; }
        #cardValueAccent { color: @ACCENT; }
        #budgetName {
            font-size: 14px;
            font-weight: 700;
            color: @TEXT;
            background: transparent;
            border: none;
        }

        /* ============ BUTTONS ============ */
        QPushButton {
            background-color: @ACCENT;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 9px 20px;
            font-size: 13px;
            font-weight: 600;
        }
        QPushButton:hover {
            background-color: @ACCENT_DARK;
        }
        QPushButton:pressed {
            background-color: @ACCENT_DARK;
        }
        QPushButton:disabled {
            background-color: @DISABLED_BG;
            color: @TOOLTIP_TEXT;
        }
        QPushButton#primaryBtn {
            background-color: @ACCENT;
        }
        QPushButton#primaryBtn:hover {
            background-color: @ACCENT_DARK;
        }
        QPushButton#secondaryBtn {
            background-color: @SEG_BG;
            color: @TEXT_BODY;
            border: 1px solid @INPUT_BORDER;
        }
        QPushButton#secondaryBtn:hover {
            background-color: @TABLE_ALT;
        }
        QPushButton#dangerBtn {
            background-color: #E11D48;
        }
        QPushButton#dangerBtn:hover {
            background-color: #BE123C;
        }
        QPushButton#ghostBtn {
            background-color: transparent;
            color: @ACCENT;
        }
        QPushButton#ghostBtn:hover {
            background-color: @ACCENT_SOFT;
        }

        /* ============ NÚT HÀNH ĐỘNG THEO HÀNG ============ */
        QPushButton#rowEditBtn, QPushButton#rowDeleteBtn {
            background-color: transparent;
            border: none;
            border-radius: 6px;
            padding: 3px;
        }
        QPushButton#rowEditBtn:hover {
            background-color: @ACCENT_SOFT;
        }
        QPushButton#rowDeleteBtn:hover {
            background-color: #FEE2E2;
        }

        /* ============ BẢNG DỮ LIỆU ============ */
        QTableWidget {
            background-color: @CARD;
            alternate-background-color: @TABLE_ALT;
            border: 1px solid @BORDER;
            border-radius: 12px;
            gridline-color: @GRID;
            font-size: 13px;
            color: @TEXT_BODY;
            selection-background-color: @ACCENT_SOFT;
            selection-color: @TEXT;
        }
        QTableWidget::item {
            padding: @TABLE_PADDING;
            border: none;
        }
        QTableWidget::item:hover {
            background-color: @ROW_HOVER;
        }
        QHeaderView::section {
            background-color: @HEADER_BG;
            color: @HEADER_TEXT;
            padding: 10px 8px;
            border: none;
            border-bottom: 1px solid @BORDER;
            font-weight: 700;
            font-size: 12px;
        }
        QTableCornerButton::section {
            background-color: @HEADER_BG;
            border: none;
        }

        /* ============ DANH SÁCH ============ */
        QListWidget {
            background-color: @CARD;
            color: @TEXT_BODY;
            border: 1px solid @BORDER;
            border-radius: 12px;
            font-size: 13px;
            padding: 6px;
        }
        QListWidget::item {
            padding: 10px;
            border-radius: 8px;
        }
        QListWidget::item:selected {
            background-color: @ACCENT_SOFT;
            color: @TEXT;
        }
        QListWidget::item:hover {
            background-color: @ROW_HOVER;
        }

        /* ============ Ô NHẬP LIỆU ============ */
        QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox, QTextEdit {
            background-color: @INPUT_BG;
            color: @TEXT_BODY;
            border: 1px solid @INPUT_BORDER;
            border-radius: 8px;
            padding: 4px 12px;
            font-size: 13px;
            min-height: 24px;
            selection-background-color: @ACCENT;
            selection-color: white;
        }
        QLineEdit:focus, QComboBox:focus, QDateEdit:focus,
        QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus {
            border: 1.5px solid @ACCENT;
        }
        QComboBox::drop-down, QDateEdit::drop-down {
            subcontrol-origin: padding;
            subcontrol-position: top right;
            width: 24px;
            border: none;
        }
        QComboBox::down-arrow, QDateEdit::down-arrow {
            image: @DOWN_ARROW;
            width: 14px;
            height: 14px;
            margin-right: 4px;
        }
        QComboBox::down-arrow:on, QDateEdit::down-arrow:on {
            top: 1px;
            left: 1px;
        }
        QComboBox QAbstractItemView {
            background-color: @CARD;
            color: @TEXT_BODY;
            selection-background-color: @ACCENT_SOFT;
            selection-color: @TEXT;
            border: 1px solid @BORDER;
            border-radius: 8px;
            outline: none;
        }
        /* Style cho DateRange Frame */
        #dateRangeFrame {
            background-color: @INPUT_BG;
            border: 1px solid @INPUT_BORDER;
            border-radius: 8px;
            min-height: 24px;
            padding: 0 8px;
        }
        #dateRangeFrame:hover {
            border: 1.5px solid @ACCENT;
        }
        #dateRangeInput {
            border: none;
            background: transparent;
            padding: 0;
            min-height: 20px;
        }
        #dateRangeInput:focus {
            border: none;
        }
        #dateRangeInput::drop-down {
            width: 20px;
            border: none;
        }
        
        QDateEdit::drop-down, QSpinBox::up-button, QSpinBox::down-button,
        QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
            width: 20px;
        }

        /* ============ CALENDAR WIDGET ============ */
        QCalendarWidget QWidget#qt_calendar_navigationbar {
            background-color: @HEADER_BG;
            border-bottom: 1px solid @BORDER;
        }
        QCalendarWidget QWidget#qt_calendar_calendarview {
            alternate-background-color: @HEADER_BG;
        }
        QCalendarWidget QAbstractItemView:enabled {
            background-color: @CARD;
            color: @TEXT_BODY;
            selection-background-color: @ACCENT;
            selection-color: white;
        }
        QCalendarWidget QAbstractItemView:disabled {
            color: @TEXT_MUTED;
        }
        QCalendarWidget QToolButton {
            color: @TEXT;
            background-color: transparent;
            border: none;
            border-radius: 4px;
            padding: 2px 4px;
        }
        QCalendarWidget QToolButton:hover {
            background-color: @HOVER_BG;
        }
        QCalendarWidget QToolButton::menu-indicator {
            image: none;
        }
        QCalendarWidget QMenu {
            background-color: @CARD;
            color: @TEXT_BODY;
            border: 1px solid @BORDER;
        }
        QCalendarWidget QSpinBox {
            background-color: @INPUT_BG;
            color: @TEXT_BODY;
            border: 1px solid @INPUT_BORDER;
            border-radius: 4px;
            selection-background-color: @ACCENT_SOFT;
            selection-color: @TEXT;
        }

        /* ============ CHECKBOX / RADIO ============ */
        QCheckBox::indicator, QRadioButton::indicator {
            width: 18px;
            height: 18px;
            border: 2px solid @INPUT_BORDER;
            border-radius: 5px;
            background-color: @INPUT_BG;
        }
        QCheckBox::indicator:checked {
            background-color: @ACCENT;
            border-color: @ACCENT;
        }
        QRadioButton::indicator {
            border-radius: 10px;
        }
        QRadioButton::indicator:checked {
            background-color: @ACCENT;
            border-color: @ACCENT;
        }

        /* ============ GROUP BOX ============ */
        QGroupBox {
            font-weight: 700;
            font-size: 13px;
            color: @TEXT;
            background-color: @CARD;
            border: 1px solid @BORDER;
            border-radius: 12px;
            padding-top: 18px;
            margin-top: 12px;
        }
        QGroupBox::title {
            subcontrol-origin: margin;
            left: 14px;
            padding: 0 6px;
        }

        /* ============ PROGRESS BAR ============ */
        QProgressBar {
            background-color: @PROGRESS_BG;
            border: none;
            border-radius: 6px;
            text-align: center;
            height: 14px;
            font-size: 10px;
            color: @TEXT_BODY;
        }
        QProgressBar::chunk {
            border-radius: 6px;
            background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 @ACCENT, stop:1 @ACCENT_LIGHT_STRONG);
        }

        /* ============ DIALOG ============ */
        QDialog, QMessageBox {
            background-color: @CARD;
        }

        /* ============ SCROLL AREA / BAR ============ */
        QScrollArea {
            border: none;
            background: transparent;
        }
        QScrollArea > QWidget > QWidget {
            background: transparent;
        }
        QScrollBar:vertical {
            background: transparent;
            width: 10px;
            margin: 2px;
        }
        QScrollBar::handle:vertical {
            background: @SCROLL_HANDLE;
            border-radius: 5px;
            min-height: 30px;
        }
        QScrollBar::handle:vertical:hover {
            background: @TEXT_MUTED;
        }
        QScrollBar:horizontal {
            background: transparent;
            height: 10px;
            margin: 2px;
        }
        QScrollBar::handle:horizontal {
            background: @SCROLL_HANDLE;
            border-radius: 5px;
            min-width: 30px;
        }
        QScrollBar::add-line, QScrollBar::sub-line {
            width: 0px;
            height: 0px;
        }
        QScrollBar::add-page, QScrollBar::sub-page {
            background: transparent;
        }

        /* ============ BIỂU ĐỒ ============ */
        QChartView {
            background-color: transparent;
        }

        /* ============ SETTINGS ============ */
        #segBtn {
            background-color: @SEG_BG;
            color: @TEXT_BODY;
            border: 1px solid @INPUT_BORDER;
            border-radius: 8px;
            padding: 8px 18px;
            font-weight: 600;
        }
        #segBtn:checked {
            background-color: @ACCENT;
            color: white;
            border-color: @ACCENT;
        }
        #swatchBtn {
            border-radius: 16px;
            border: 3px solid transparent;
        }
        #swatchBtn:checked {
            border: 3px solid @TEXT;
        }
